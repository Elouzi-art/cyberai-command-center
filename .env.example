# Copier vers .env (jamais commité). Placeholders uniquement.
APP_ENV=development
LOG_LEVEL=INFO

# Backend
DATABASE_URL=sqlite:////data/app.db
CONFIG_PATH=/app/config.yaml
ALLOWED_ORIGINS=http://localhost:8080
# true par défaut (cookie Secure). Mettre false UNIQUEMENT en HTTP local.
COOKIE_SECURE=false

# Agent de démonstration (chiffres SIMULÉS, pour développer le dashboard). false en production.
DEMO_AGENT=true

# Garde-fou : politique de risque (L0-L4) et file d'approbation
POLICY_PATH=/app/policy/tools.yaml
APPROVAL_TTL_MINUTES=60
# false en production : l'auteur d'une demande ne peut pas l'approuver (séparation des rôles)
ALLOW_SELF_APPROVAL=false

# Providers IA (laisser vide si non utilisé)
OLLAMA_BASE_URL=http://ollama:11434
CLOUD_PROVIDER_API_KEY=
