# Copier vers .env (jamais commité). Placeholders uniquement.
APP_ENV=development
LOG_LEVEL=INFO

# Backend
DATABASE_URL=sqlite:////data/app.db
CONFIG_PATH=/app/config.yaml
ALLOWED_ORIGINS=http://localhost:8080
# true par défaut (cookie Secure). Mettre false UNIQUEMENT en HTTP local.
COOKIE_SECURE=false

# Providers IA (laisser vide si non utilisé)
OLLAMA_BASE_URL=http://ollama:11434
CLOUD_PROVIDER_API_KEY=
